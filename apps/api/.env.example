# NHGP API Environment
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://nhgp:nhgp@localhost:5432/nhgp?schema=public"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-secure-random-string-min-32-chars"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string-min-32"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Document Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/documents

# AI (set AI_PROVIDER=openai and AI_API_KEY to enable)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Super Admin (for db:seed)
SUPER_ADMIN_EMAIL=admin@ndukego.com
SUPER_ADMIN_PASSWORD=ChangeMeNow123!
